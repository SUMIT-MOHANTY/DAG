# Application
APP_NAME="Restriction Intelligence API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./restriction_intelligence.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Security — CHANGE IN PRODUCTION
JWT_SECRET_KEY=change-me-in-production-super-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# LLM
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Business Thresholds
RISK_THRESHOLD=4
CONFIDENCE_THRESHOLD=0.7
AUTO_APPROVE_CONFIDENCE=0.95

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
